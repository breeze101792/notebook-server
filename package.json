{
  "name": "notebook-frontend-tests",
  "private": true,
  "description": "DOM-level tests for the Markdown notebook server frontend (jsdom).",
  "scripts": {
    "test": "node tests/dom/test_dom.js",
    "test:browser": "node tests/browser/test_hybrid_browser.js",
    "test:browser:firefox": "BROWSER=firefox node tests/browser/test_hybrid_browser.js",
    "vendor:visimer": "node_modules/.bin/esbuild static/vendor/visimer.entry.js --bundle --format=iife --global-name=Visimer --minify --outfile=static/vendor/visimer.bundle.js",
    "test:browser:all": "node tests/browser/run_all.js",
    "test:browser:core": "node tests/browser/test_core_ui_browser.js",
    "test:browser:auth": "node tests/browser/test_auth_export_browser.js",
    "test:browser:ai": "node tests/browser/test_ai_editor_browser.js",
    "test:browser:blocks": "node tests/browser/test_block_edit_browser.js",
    "test:browser:hybrid-blocks": "node tests/browser/test_hybrid_blocks_browser.js",
    "test:browser:mobile": "node tests/browser/test_mobile_browser.js",
    "test:browser:designer": "node tests/browser/test_designer_browser.js",
    "test:browser:dw": "node tests/browser/test_dw_designer_browser.js"
  },
  "devDependencies": {
    "@codemirror/buildhelper": "^1.0.2",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@replit/codemirror-vim": "^6.3.0",
    "@visimer/core": "1.1.2",
    "@visimer/dom": "1.1.2",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.1",
    "jsdom": "^24.1.3",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "mermaid": "^11.16.0"
  }
}
